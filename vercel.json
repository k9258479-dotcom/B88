{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|assets/|admin\\.html|paymongo-checkout\\.html|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
